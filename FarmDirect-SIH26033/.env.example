# FarmDirect Environment Variables Template

# Flask Server Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=farmdirect_dev_secret_key_change_in_production_sih2026
JWT_SECRET_KEY=farmdirect_jwt_secret_key_change_in_production_sih2026

# Database Configuration (MySQL + SQLAlchemy)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=farmdirect_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# CORS Configuration
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5000,http://127.0.0.1:5000
